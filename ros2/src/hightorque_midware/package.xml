<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hightorque_midware</name>
  <version>0.0.1</version>
  <description>Middleware for hightorque robots with motor control SDK</description>
  <maintainer email="yshzzpp@foxmail.com">zzpp</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>hightorque_robot</depend>
  <depend>hightorque_kinematics_core</depend>
  <depend>hightorque_msgs</depend>
  <depend>boost</depend>
  <depend>libboost-serialization-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
